NODE_ENV=development
PORT=5000
# Set to 1 when behind a load balancer / reverse proxy (ALB, nginx)
TRUST_PROXY=0
APP_TIMEZONE=Asia/Kolkata

MONGO_URI=mongodb://127.0.0.1:27017/folderly

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex-string-replace-with-64-byte-random
JWT_ACCESS_EXPIRES=15m
JWT_ISSUER=folderly
JWT_AUDIENCE=folderly-clients
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Comma separated list of allowed front-end origins (empty = no cross-origin)
CORS_ORIGINS=http://localhost:3000

AWS_REGION=ap-south-1
AWS_S3_BUCKET=folderly-files-prod
# Leave empty in production on AWS (use IAM role). Only set for local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
SIGNED_URL_TTL_SECONDS=300

LOG_LEVEL=info

# Used only by: npm run seed:admin
ADMIN_NAME=Super Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe#12345
